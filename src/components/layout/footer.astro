---
import LokkeeStudiosLogo from '@/assets/images/logos/lokkeestudios.svg';
import { CopyrightText } from '@/components/layout/copyright-text';
import { Container } from '@/components/ui/container';
import { Icons } from '@/components/ui/icons';

interface Props {
  primaryLinks: Array<{ label: string; href: string }>;
  secondaryLinks: Array<{ label: string; href: string }>;
  socials: Array<{ label: string; href: string; icon: 'github' | 'instagram' | 'linkedin' }>;
  ariaPrimary: string;
  ariaSecondary: string;
  ariaSocials: string;
  navigateHomeTitle: string;
  homeUrl?: string;
}

const {
  primaryLinks,
  secondaryLinks,
  socials,
  ariaPrimary,
  ariaSecondary,
  ariaSocials,
  navigateHomeTitle,
  homeUrl = '/',
} = Astro.props;

const iconMap = {
  github: Icons.GitHub,
  instagram: Icons.Instagram,
  linkedin: Icons.LinkedIn,
} as const;
---

<footer
  aria-label={ariaPrimary}
  class="border-neutrals-600 bg-neutrals-900 relative z-10 w-full border-t-[0.5px] py-3"
>
  <Container>
    <div class="flex justify-center py-12">
      <a
        href={homeUrl}
        title={navigateHomeTitle}
      >
        <LokkeeStudiosLogo class="size-16" />
      </a>
    </div>
    <hr class="via-neutrals-600 h-px border-0 bg-linear-to-r from-transparent to-transparent" />
    <nav
      aria-label={ariaPrimary}
      class="flex flex-wrap justify-center gap-6 py-12"
    >
      {
        primaryLinks.map((link) => (
          <a
            href={link.href}
            class="text-neutrals-300 hover:text-neutrals-50 focus-visible:text-neutrals-50 text-sm uppercase transition-colors"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <hr class="via-neutrals-600 h-px border-0 bg-linear-to-r from-transparent to-transparent" />
    <div class="grid grid-cols-1 items-center justify-center gap-6 py-12 lg:grid-cols-3">
      <nav
        aria-label={ariaSecondary}
        class="flex flex-wrap justify-center gap-6 lg:order-last lg:justify-end"
      >
        {
          secondaryLinks.map((link) => (
            <a
              class="text-neutrals-300 hover:text-neutrals-50 focus-visible:text-neutrals-50 text-xs uppercase transition-colors"
              href={link.href}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <ul
        aria-label={ariaSocials}
        class="flex flex-wrap justify-center gap-2"
      >
        {
          socials.map(({ label, href, icon }) => {
            const Icon = iconMap[icon];
            return (
              <li>
                <a
                  href={href}
                  title={label}
                  aria-label={label}
                  rel="noreferrer"
                  target="_blank"
                  class="text-neutrals-300 hover:text-neutrals-50 focus-visible:text-neutrals-50 transition-colors"
                >
                  <Icon
                    aria-hidden
                    className="size-7"
                  />
                </a>
              </li>
            );
          })
        }
      </ul>
      <div class="flex justify-center lg:order-first lg:justify-start">
        <CopyrightText client:visible />
      </div>
    </div>
  </Container>
</footer>
