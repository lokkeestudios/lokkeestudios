---
import { siteConfig } from '@/lib/config/site';
import { defaultLocale, getTranslations } from '@/i18n';
import type { Locale } from '@/i18n/translations';
import '@/styles/globals.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/700.css';
import { SEO } from 'astro-seo';
import { Head as InternalHead } from 'astro-capo';
import { env } from '@/t3-env';

type Props = {
  title?: string | undefined;
  description?: string | undefined;
  openGraphImage?: { src: string; alt: string } | undefined;
  // Current locale for og:locale; if set, alternateLocaleUrls should also be set for hreflang
  locale?: string;
  // Full URLs for the same page in each locale (for hreflang and x-default)
  alternateLocaleUrls?: { en: string; de: string };
};

const {
  title,
  description,
  openGraphImage,
  locale: currentLocale,
  alternateLocaleUrls,
} = Astro.props;

const { pathname } = Astro.url;

const { PUBLIC_GOOGLE_SITE_VERIFICATION, PUBLIC_GOOGLE_ANALYTICS_ID, DEV: isDevMode } = env;

const { name: siteName, url: siteUrl } = siteConfig;

const locale = (currentLocale ?? defaultLocale) as Locale;
const t = getTranslations(locale);
const siteSlogan = t.site.slogan;
const siteDescription = t.site.description;

const canonical = `${siteUrl}${pathname}`;

const ogLocale = currentLocale === 'de' ? 'de_DE' : 'en_US';
const ogLocaleAlternate = currentLocale === 'de' ? 'en_US' : 'de_DE';
---

<InternalHead>
  <SEO
    charset="UTF-8"
    title={title!}
    titleTemplate={`%s | ${siteName}`}
    titleDefault={`${siteName} | ${siteSlogan}`}
    description={description ?? siteDescription}
    canonical={canonical}
    openGraph={{
      basic: {
        title: title ?? siteSlogan,
        type: 'website',
        url: canonical,
        image: openGraphImage?.src ?? '/banner-1200x630.png',
      },
      optional: {
        description: description ?? siteDescription,
        siteName,
      },
      image: {
        alt: openGraphImage?.alt ?? siteName,
        width: 1200,
        height: 630,
      },
    }}
    twitter={{
      card: 'summary_large_image',
    }}
    extend={{
      link: [
        // Makes sure a favicon is also shown in dev mode, before its generation. Ensures there is no duplicate link in the production build
        ...(isDevMode ? [{ rel: 'icon', href: '/favicon.svg', type: 'image/svg+xml' }] : []),
        { rel: 'sitemap', href: '/sitemap-index.xml' },
        // Alternate language versions (same page in en/de) for SEO
        ...(alternateLocaleUrls
          ? [
              { rel: 'alternate', hreflang: 'en', href: alternateLocaleUrls.en },
              { rel: 'alternate', hreflang: 'de', href: alternateLocaleUrls.de },
              { rel: 'alternate', hreflang: 'x-default', href: alternateLocaleUrls.en },
            ]
          : []),
      ],
      meta: [
        { name: 'viewport', content: 'width=device-width' },
        { name: 'robots', content: 'index' },
        { name: 'generator', content: Astro.generator },
        {
          name: 'google-site-verification',
          content: PUBLIC_GOOGLE_SITE_VERIFICATION,
        },
        ...(currentLocale
          ? [
              { property: 'og:locale', content: ogLocale },
              { property: 'og:locale:alternate', content: ogLocaleAlternate },
            ]
          : []),
      ],
    }}
  />
  <script
    type="text/partytown"
    is:inline
    async
    src={`https://www.googletagmanager.com/gtag/js?id=${PUBLIC_GOOGLE_ANALYTICS_ID}`}
  ></script>
  <script type="text/partytown" is:inline define:vars={{ PUBLIC_GOOGLE_ANALYTICS_ID }}>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag('js', new Date());

    gtag('config', PUBLIC_GOOGLE_ANALYTICS_ID);
  </script>
</InternalHead>
