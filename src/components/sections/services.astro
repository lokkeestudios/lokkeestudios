---
import { ServicesBreakdown } from '@/components/services-grid';
import { Button } from '@/components/ui/button';
import { Container } from '@/components/ui/container';
import Section from '@/components/ui/section.astro';
import { Caption, Heading, Paragraph } from '@/components/ui/typography';
import { defaultLocale, getLocaleBasePath, getTranslations } from '@/i18n';
import type { Locale } from '@/i18n/translations';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = getTranslations(locale);
const base = getLocaleBasePath(locale);
const root = base ? `${base}/` : '/';
---

<Section
  id="services"
  aria-labelledby="services-heading"
  hasBorderTop
>
  <Container>
    <div class="mb-16 flex flex-col items-center text-center">
      <Caption id="services-heading">{t.services.caption}</Caption>
      <Heading>
        {t.services.heading.split(', ')[0]},
        <br class="lg:hidden" />
        {t.services.heading.split(', ')[1]}
      </Heading>
      <div class="flex flex-col items-center gap-2">
        <Paragraph>
          {t.services.paragraph1}
        </Paragraph>
        <Paragraph className="text-balance">
          {t.services.paragraph2}
        </Paragraph>
      </div>
    </div>
    <ServicesBreakdown client:visible />
    <div class="mt-8 flex flex-col items-center text-center">
      <Paragraph>
        {t.services.footerText}
        <br />
        <span class="text-neutrals-100 group">{t.services.footerHighlight}</span>
      </Paragraph>
      <Button
        className="mt-8"
        as="a"
        href={`${root}#contact`}
      >
        {t.services.cta}
      </Button>
    </div>
  </Container>
</Section>
