---
import { MatrixBackground } from '@/components/matrix-background';
import { Button } from '@/components/ui/button';
import { Container } from '@/components/ui/container';
import Section from '@/components/ui/section.astro';
import { Caption, Heading, Paragraph } from '@/components/ui/typography';
import { siteConfig } from '@/lib/config/site';
import { defaultLocale, getTranslations } from '@/i18n';
import type { Locale } from '@/i18n/translations';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = getTranslations(locale);
---

<Section
  id="source-code"
  aria-labelledby="sourcecode-heading"
  hasBorderTop
>
  <MatrixBackground client:visible />
  <Container>
    <div class="flex h-full flex-col items-center justify-center text-center">
      <Caption id="sourcecode-heading">{t.sourceCode.caption}</Caption>
      <Heading>{t.sourceCode.heading}</Heading>
      <Paragraph>
        {t.sourceCode.body}
      </Paragraph>
      <Button
        as="a"
        href={siteConfig.links.sourcecode}
        rel="noreferrer"
        target="_blank"
        foreground="error"
        className="mt-8"
      >
        {t.sourceCode.cta}
      </Button>
    </div>
  </Container>
</Section>
