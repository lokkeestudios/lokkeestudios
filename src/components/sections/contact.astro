---
import { ContactForm } from '@/components/contact-form';
import { Container } from '@/components/ui/container';
import Section from '@/components/ui/section.astro';
import { Caption, Heading, Paragraph } from '@/components/ui/typography';
import { defaultLocale, getTranslations } from '@/i18n';
import type { Locale } from '@/i18n/translations';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = getTranslations(locale);
---

<Section
  id="contact"
  aria-labelledby="contact-heading"
  hasBorderTop
>
  <Container>
    <div class="flex h-full w-full flex-col lg:relative lg:flex-row">
      <div class="basis-full self-start lg:sticky lg:top-24">
        <Caption id="contact-heading">{t.contact.caption}</Caption>
        <Heading>{t.contact.heading}</Heading>
        <Paragraph>
          {t.contact.body}
        </Paragraph>
      </div>
      <div class="mt-10 basis-full lg:ms-10 lg:mt-0 xl:ms-20">
        <ContactForm
          client:idle
          translations={t.contact.form}
        />
      </div>
    </div>
  </Container>
</Section>
