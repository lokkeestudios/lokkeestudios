---
import { GridBackground } from '@/components/grid-background';
import { Button } from '@/components/ui/button';
import { Container } from '@/components/ui/container';
import { defaultLocale, getLocaleBasePath, getTranslations } from '@/i18n';
import type { Locale } from '@/i18n/translations';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = getTranslations(locale);
const base = getLocaleBasePath(locale);
const root = base ? `${base}/` : '/';
---

<section
  aria-labelledby="hero-heading"
  class="sticky inset-0 flex h-svh w-full flex-col justify-center py-28"
>
  <GridBackground client:visible />
  <Container>
    <div class="flex flex-col items-center justify-center">
      <h1
        id="hero-heading"
        class="from-neutrals-50 to-primary bg-radial from-50% bg-clip-text text-center text-4xl/tight font-bold text-balance text-transparent sm:text-5xl/tight md:text-7xl/tight lg:text-8xl/tight"
      >
        {t.hero.title}
      </h1>
      <div class="mt-12 flex items-stretch gap-x-6 gap-y-3 max-sm:flex-col sm:items-center">
        <Button
          as="a"
          href={`${root}#projects`}
          background="primary"
          size="large"
        >
          {t.hero.ctaWork}
        </Button>
        <Button
          as="a"
          href={`${root}#services`}
          background="primary"
          size="large"
          isGhost
        >
          {t.hero.ctaServices}
        </Button>
      </div>
    </div>
  </Container>
</section>
