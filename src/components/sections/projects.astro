---
import { ProjectCarousel } from '@/components/project-carousel';
import { Container } from '@/components/ui/container';
import Section from '@/components/ui/section.astro';
import { Caption, Heading } from '@/components/ui/typography';
import { defaultLocale, getTranslations } from '@/i18n';
import type { Locale } from '@/i18n/translations';
import { getProjects } from '@/lib/sanity/get-projects';

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const projects = await getProjects(locale);
const t = getTranslations(locale);
---

<Section
  id="projects"
  aria-labelledby="projects-heading"
  hasBorderTop
  hasGlowEffect
>
  <Container>
    <div class="flex flex-col items-center text-center">
      <Caption id="projects-heading">{t.projects.caption}</Caption>
      <Heading>{t.projects.heading}</Heading>
    </div>
  </Container>
  <ProjectCarousel
    client:idle
    projects={projects}
  />
</Section>
