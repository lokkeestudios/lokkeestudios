---
import ImprintSection from '@/components/sections/imprint.astro';
import Layout from '@/layouts/layout.astro';
import { defaultLocale, getTranslations } from '@/i18n';
import type { Locale } from '@/i18n/translations';

const t = getTranslations((Astro.currentLocale ?? defaultLocale) as Locale);
---

<Layout title={t.imprint.pageTitle}>
  <main id="main">
    <ImprintSection />
  </main>
</Layout>
